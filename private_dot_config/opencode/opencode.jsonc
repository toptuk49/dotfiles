{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-ascii", "opencode-bell"],
  "default_agent": "chat",
  "agent": {
    "chat": {
      "color": "#a4fd75",
      "prompt": "",
      "tools": {
        "websearch": true,
        "webfetch": true,
        "bash": true,
        "edit": false,
        "patch": false
      }
    }
  }
}
